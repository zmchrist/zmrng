# zmrng configuration — copy to .env and adjust as needed.
# Every var has a sane default; zmrng runs with no .env at all.

# Repo registry: zmrng auto-lists every git repo directly under this directory
# in the repo dropdown (alongside any config/repos.json or ZMRNG_REPOS entries).
# When unset, it resolves to the FIRST of these that exists, so existing
# installs keep working: ~/Projects -> ~/Developer/Projects -> ~/Documents/Projects
# ZMRNG_PROJECTS_DIR=~/Projects

# Legacy single-target fallback (only used when no registry/scan repos resolve).
# Leave unset: no fallback entry is emitted, and the zmrng self entry plus the
# ZMRNG_PROJECTS_DIR auto-scan supply a usable default registry.
# ZMRNG_TARGET_REPO=~/Projects/example-app

# Default repo for new tasks. Defaults to zmrng itself when unset, so a
# default-repo task operates in the zmrng checkout. Set to a registry id to pin.
# ZMRNG_DEFAULT_REPO=zmrng

# Port the Fastify server listens on (web dev proxy points here).
ZMRNG_PORT=4500

# Default Claude model for new tasks (opus | sonnet).
ZMRNG_MODEL=opus

# Max number of tasks allowed in the autonomous "building" phase at once.
# Extra tasks that reach READY queue until a lane frees.
ZMRNG_MAX_LANES=2

# IMPORTANT: do NOT set ANTHROPIC_API_KEY in this environment.
# zmrng spawns the real `claude` binary using your Max OAuth login.
# If ANTHROPIC_API_KEY is present it is stripped from the child process
# (otherwise claude would silently bill the metered API instead of Max).

# Worker auth mode — oauth (default) | apikey.
#   oauth  : ANTHROPIC_API_KEY is stripped from worker child envs so `claude`
#            authenticates with your Max OAuth login. Safe default.
#   apikey : ANTHROPIC_API_KEY is PRESERVED and passed through to workers, so
#            a stranger with no Max login can still run tasks.
#            WARNING: this bills the metered Anthropic API per task — it is
#            NOT free like Max OAuth. Only opt in if you intend to pay for
#            API usage.
# ZMRNG_AUTH_MODE=apikey

# ── Team workspace (VPS deploy) ──────────────────────────────────────────────
# These only matter when running this server as the shared Team-workspace server
# on a VPS (see docs/team-workspace-deploy.md). The local app leaves them unset.
# SECURITY: the workspace port must be reachable ONLY over Tailscale — the
# tailnet is the perimeter, there is no app-code auth (self-asserted handles).

# Stable dir for zmrng.db so channels/messages/members survive a redeploy.
# Defaults to the checkout root; set an absolute path on a server deploy.
# ZMRNG_DATA_DIR=/var/lib/zmrng-workspace

# Server-side default workspace URL, surfaced to clients via GET /api/config.
# Optional — teammates can instead paste it into Settings (localStorage
# zmrng-workspace-url), which wins over this when present. Use the tailnet
# IP / MagicDNS name, e.g. http://100.x.y.z:4500
# ZMRNG_WORKSPACE_URL=

# @mention team agent (T4). Leave the two path/id vars blank to run the
# workspace WITHOUT a bot (channels + presence + handoff still work).
# Absolute path to a read-only reference checkout the bot `git pull`s before it
# answers; empty = the pull is skipped gracefully.
# ZMRNG_WORKSPACE_REPO_PATH=/opt/zmrng-workspace-refcheckout
# id of the AgentTarget (config/agents.json) that acts as the bot; empty selects
# the first configured agent.
# ZMRNG_WORKSPACE_BOT_AGENT=
# The @mention handle that triggers the bot (default @agent).
# ZMRNG_WORKSPACE_BOT_HANDLE=@agent
# How many recent channel messages are relayed to the bot as context (default 20).
# ZMRNG_WORKSPACE_SCROLLBACK=20
# Per-request timeout (ms) that caps a hung upstream bot (default 60000).
# ZMRNG_WORKSPACE_AGENT_TIMEOUT_MS=60000
