# zmrng configuration — copy to .env and adjust as needed.

# Absolute path (or ~) to the target git repo zmrng drives. v1 = Pheme.
ZMRNG_TARGET_REPO=~/Documents/Projects/pheme

# Port the Fastify server listens on (web dev proxy points here).
ZMRNG_PORT=4500

# Default Claude model for new tasks (opus | sonnet).
ZMRNG_MODEL=opus

# Max number of tasks allowed in the autonomous "building" phase at once.
# Extra tasks that reach READY queue until a lane frees.
ZMRNG_MAX_LANES=2

# IMPORTANT: do NOT set ANTHROPIC_API_KEY in this environment.
# zmrng spawns the real `claude` binary using your Max OAuth login.
# If ANTHROPIC_API_KEY is present it is stripped from the child process
# (otherwise claude would silently bill the metered API instead of Max).
