node_modules/
dist/
*.tsbuildinfo
*.db
*.db-shm
*.db-wal
worktrees/*
!worktrees/.gitkeep
.env
config/repos.json
.DS_Store

# Tauri desktop — Rust build output + generated sidecar/web bundle
packages/desktop/src-tauri/target/
packages/desktop/src-tauri/gen/
packages/desktop/src-tauri/sidecar/
packages/desktop/src-tauri/web-dist/

# Icons: commit only the macOS set the bundler references (so a fresh clone
# builds); ignore the cross-platform variants `tauri icon` also generates.
packages/desktop/src-tauri/icons/*
!packages/desktop/src-tauri/icons/README.md
!packages/desktop/src-tauri/icons/32x32.png
!packages/desktop/src-tauri/icons/128x128.png
!packages/desktop/src-tauri/icons/128x128@2x.png
!packages/desktop/src-tauri/icons/icon.icns
