{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zmrng",
  "version": "0.1.0",
  "identifier": "com.zmrng.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "zmrng",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["sidecar/node"],
    "resources": ["sidecar/server.mjs", "sidecar/node_modules/**/*", "web-dist/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
