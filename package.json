{
  "name": "zmrng",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous task orchestrator GUI — drives Claude Code headless against a configurable registry of target repos",
  "workspaces": [
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build --workspaces --if-present",
    "build:server": "npm run build -w packages/server",
    "build:web": "npm run build -w packages/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "concurrently -n server,web -c blue,green \"npm run test:watch -w @zmrng/server\" \"npm run test:watch -w @zmrng/web\"",
    "start": "npm run start -w packages/server",
    "bundle:sidecar": "npm run bundle:sidecar -w @zmrng/desktop",
    "desktop:dev": "npm run tauri -w @zmrng/desktop -- dev",
    "desktop:build": "npm run build && npm run bundle:sidecar && npm run tauri -w @zmrng/desktop -- build"
  },
  "engines": {
    "node": ">=20.11.0 <23"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node@1.21.0": true,
    "onnxruntime-node@1.24.3": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
